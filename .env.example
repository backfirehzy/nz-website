# ---- Sanity ----
# 在 https://www.sanity.io/manage 创建项目后填写
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# 服务端写入 token（contactSubmission 留存用），Editor 权限，切勿提交到仓库
SANITY_API_TOKEN=

# ---- Resend（询盘邮件通知）----
# 未配置时表单提交仍可成功（跳过发件，仅留存到 Sanity），配置后恢复邮件通知
RESEND_API_KEY=
# 询盘接收邮箱（待客户确认，见 references/open-questions.md #9）
CONTACT_EMAIL_TO=
# Resend 发件地址，未验证域名前可用 onboarding@resend.dev
CONTACT_EMAIL_FROM="Website <onboarding@resend.dev>"

# ---- Cloudflare Turnstile（表单防垃圾）----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
